{
  "name": "ldstatuspro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "^3.2.5"
  },
  "scripts": {
    "lint:userscript": "eslint LDStatusPro.user.js",
    "fmt": "prettier --write LDStatusPro.user.js",
    "embed:core": "node scripts/embed-core.mjs",
    "embed:core:check": "node scripts/embed-core.mjs --check",
    "embed:i18n": "node scripts/embed-i18n.mjs",
    "embed:i18n:check": "node scripts/embed-i18n.mjs --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint:userscript && npm run check:i18n && npm test && npm run embed:core:check && npm run embed:i18n:check",
    "check:agent-samples": "node scripts/validate-agent-samples.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3"
  }
}
