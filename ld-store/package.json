{
  "name": "ld-store",
  "version": "1.0.0",
  "description": "LD士多网页版 - LDC积分商城",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint . --ext .js,.ts,.vue --ignore-pattern dist --ignore-pattern node_modules --ignore-pattern .wrangler --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run check:architecture && npm run check:styles && npm run check:csp && npm run validate:noindex && npm run audit && npm run test && npm run build && npm run check:csp:build && npm run validate:noindex:build && npm run validate:og && npm run check:bundle",
    "check:deploy": "npm run lint && npm run typecheck && npm run check:architecture && npm run check:styles && npm run check:csp && npm run validate:noindex && npm run audit && npm run build && npm run check:csp:build && npm run validate:noindex:build && npm run validate:og && npm run check:bundle",
    "audit": "node scripts/check-audit.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:styles": "node scripts/check-style-tokens.mjs",
    "check:csp": "node scripts/check-strict-csp.mjs",
    "check:csp:build": "node scripts/check-strict-csp.mjs --build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build": "vite build",
    "build:csp-smoke": "vite build --config tests/fixtures/strict-csp-smoke/vite.config.js",
    "validate:noindex": "node scripts/validate-noindex-policy.mjs",
    "validate:noindex:build": "node scripts/validate-noindex-policy.mjs --build",
    "validate:og": "node scripts/validate-open-graph.mjs",
    "build:private-metadata": "bash scripts/build-private-metadata.sh",
    "preview": "vite preview",
    "preview:csp": "node scripts/strict-csp-preview.mjs",
    "preview:csp:smoke": "STRICT_CSP_DIST_DIR=.csp-smoke-dist node scripts/strict-csp-preview.mjs",
    "preview:tabs": "vite --config tests/fixtures/liquid-tabs-preview/vite.config.js",
    "preview:services": "vite --config tests/fixtures/top-service-preview/vite.config.js",
    "deploy": "bash scripts/deploy-pages-production.sh",
    "test:e2e": "node scripts/run-browser-tests.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "2.11.0",
    "@grafana/faro-web-tracing": "2.11.0",
    "@lucide/vue": "^1.38.0",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "marked": "^18.0.11",
    "pinia": "^2.1.0",
    "qrcode": "1.5.4",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.0.0",
    "https-proxy-agent": "^9.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12"
  }
}
